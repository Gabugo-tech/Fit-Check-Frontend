# ── Backend API URL ───────────────────────────────────────────────────────────
# Your deployed backend URL (fitcheck-backend repo on Vercel)
# Development: http://localhost:3001
# Production:  https://your-fitcheck-backend.vercel.app
VITE_API_URL="https://your-fitcheck-backend.vercel.app"

# ── Admin ─────────────────────────────────────────────────────────────────────
# The email address that has admin dashboard access
VITE_ADMIN_EMAIL="your-admin@email.com"

# ── Cloudinary (Image Uploads) ───────────────────────────────────────────────
VITE_CLOUDINARY_CLOUD_NAME="your-cloud-name"
VITE_CLOUDINARY_UPLOAD_PRESET="your-unsigned-preset-name"
